<div class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-base-300 bg-base-100/95 backdrop-blur"
     data-controller="article-cta"
     data-testid="article-sticky-cta">
  <div class="container mx-auto flex items-center gap-3 px-4 py-3">
    <p class="flex-1 text-sm font-medium leading-snug"><%= content_page_cta_text(:sticky) %></p>
    <%= link_to content_page_cta_text(:button), register_path, class: "btn btn-primary btn-sm shrink-0" %>
    <button type="button" class="btn btn-ghost btn-sm btn-circle shrink-0" data-action="article-cta#dismiss" aria-label="<%= t("content_pages.cta.dismiss") %>">
      <%= icon("x", class: "size-4") %>
    </button>
  </div>
</div>
